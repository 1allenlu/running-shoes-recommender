LLM_PROVIDER=anthropic             # anthropic | google (free tier) | ollama (free, local)
LLM_MODEL=                         # empty = default: claude-opus-5-5 / gemini-3.5-flash-lite / qwen3-vl:8b
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                    # free key: aistudio.google.com/apikey
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_BACKEND=chroma              # chroma | pgvector
DATABASE_URL=postgresql+psycopg://shoe:shoe@localhost:5432/shoe
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shoe-rec
